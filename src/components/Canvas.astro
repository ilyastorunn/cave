---
import type { FolderNode, FolderTree, Item } from '../lib/db';
import { href } from '../lib/page';
import { renderItem } from '../lib/render';
import '../styles/items.css';

interface Props {
  tree: FolderTree;
  folder: FolderNode;
  chain: FolderNode[];
  items: Item[];
  counts: Map<string, number>;
  base: string;
  edit: boolean;
}

const { tree, folder, chain, items, counts, base, edit } = Astro.props;

// Bounding box of all items, used for the initial "fit to content" view.
const bounds = items.length
  ? (() => {
      const x0 = Math.min(...items.map((i) => i.x));
      const y0 = Math.min(...items.map((i) => i.y));
      const x1 = Math.max(...items.map((i) => i.x + i.w));
      const y1 = Math.max(...items.map((i) => i.y + i.h));
      return { x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
    })()
  : null;

const itemsHtml = items
  .map((item) => {
    if (item.type !== 'folder') return renderItem(item);
    const target = item.targetFolderId ? tree.byId.get(item.targetFolderId) : undefined;
    return target ? renderItem(item, { name: target.name, href: href(base, target.path), count: counts.get(target.id) ?? 0 }) : '';
  })
  .join('');
---

<main
  class="stage"
  id="stage"
  data-folder-id={folder.id}
  data-bounds={bounds ? JSON.stringify(bounds) : undefined}
  data-edit={edit ? '' : undefined}
>
  <div class="world" id="world">
    <Fragment set:html={itemsHtml} />
    <p class="hint" hidden={items.length > 0}>{edit ? 'Dosya sürükle-bırak, link ya da görsel yapıştır, ya da aşağıdan ekle' : 'Boş canvas'}</p>
  </div>

  {
    chain.length > 1 && (
      <nav class="crumbs" data-ui aria-label="Konum">
        {chain.map((f, i) =>
          i < chain.length - 1 ? (
            <>
              <a href={href(base, f.path)}>{f.name}</a>
              <span class="sep">/</span>
            </>
          ) : (
            <span class="here" aria-current="page">{f.name}</span>
          ),
        )}
      </nav>
    )
  }

  {
    edit && (
      <div class="toolbar" data-ui>
        <button id="add-upload" title="Görsel, GIF ya da dosya yükle">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2.5" width="12" height="11" rx="2" stroke="currentColor" stroke-width="1.3"/><circle cx="6" cy="6.5" r="1.2" fill="currentColor"/><path d="M2.5 12l3.5-3.5 2.5 2.5 2-2 3 3" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
          <span>Yükle</span>
        </button>
        <button id="add-note" title="Not ekle (N)">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 2.5h10a.5.5 0 0 1 .5.5v6.5L9.5 13.5H3a.5.5 0 0 1-.5-.5V3a.5.5 0 0 1 .5-.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M9.5 13.5V10a.5.5 0 0 1 .5-.5h3.5" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
          <span>Not</span>
        </button>
        <button id="add-link" title="Link ya da embed ekle (L)">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6.5 9.5l3-3M7 4.5l1-1a2.5 2.5 0 0 1 3.5 3.5l-1 1M9 11.5l-1 1A2.5 2.5 0 0 1 4.5 9l1-1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          <span>Link</span>
        </button>
        <button id="add-folder" title="Klasör ekle">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 4.5A1.5 1.5 0 0 1 3.5 3h2.8l1.4 1.5h4.8A1.5 1.5 0 0 1 14 6v5.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 11.5v-7z" stroke="currentColor" stroke-width="1.3"/></svg>
          <span>Klasör</span>
        </button>
        <span class="divider" />
        <a href={folder.path} title="Herkese açık görünüm">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8 12.1 12.5 8 12.5 1.5 8 1.5 8z" stroke="currentColor" stroke-width="1.3"/><circle cx="8" cy="8" r="2" stroke="currentColor" stroke-width="1.3"/></svg>
          <span>Görüntüle</span>
        </a>
        <input id="file-input" type="file" multiple hidden />
      </div>
      <div class="toast" id="toast" data-ui role="status" aria-live="polite" />
      <div class="drop" id="drop" aria-hidden="true">Bırak</div>
    )
  }

  <div class="zoom" data-ui>
    <button id="zoom-out" aria-label="Uzaklaştır">−</button>
    <button id="zoom-level" class="level" aria-label="Yakınlaştırmayı sıfırla" title="100% (0)">100%</button>
    <button id="zoom-in" aria-label="Yakınlaştır">+</button>
  </div>
</main>

<style>
  .stage {
    position: fixed;
    inset: 0 0 0 var(--sidebar-w);
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: default;
    background-image: radial-gradient(circle, var(--dot) 1px, transparent 1.2px);
  }

  .stage[data-grab] {
    cursor: grab;
  }

  .stage[data-panning] {
    cursor: grabbing;
  }

  .world {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    will-change: transform;
    --inv: 1;
  }

  .hint {
    position: absolute;
    margin: 0;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    color: var(--muted);
    font-size: 13px;
    letter-spacing: 0.01em;
    pointer-events: none;
  }

  .crumbs {
    position: absolute;
    top: 14px;
    left: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: calc(100% - 32px);
    padding: 6px 10px;
    font-size: 13px;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    border-radius: 8px;
    white-space: nowrap;
    overflow: hidden;
  }

  .crumbs a:hover {
    color: var(--text);
  }

  .crumbs .here {
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sep {
    opacity: 0.5;
  }

  .zoom,
  .toolbar {
    position: absolute;
    bottom: 16px;
    display: flex;
    align-items: center;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 3px;
  }

  .zoom {
    right: 16px;
  }

  .zoom button {
    height: 28px;
    min-width: 28px;
    border-radius: 7px;
    font-size: 15px;
    color: var(--muted);
  }

  .zoom button:hover,
  .toolbar :is(button, a):hover {
    background: var(--hover);
    color: var(--text);
  }

  .zoom .level {
    min-width: 52px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .toolbar {
    left: 50%;
    transform: translateX(-50%);
    gap: 2px;
  }

  .toolbar :is(button, a) {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px;
    border-radius: 7px;
    font-size: 13px;
    color: var(--muted);
  }

  .divider {
    width: 1px;
    height: 18px;
    margin: 0 4px;
    background: var(--border);
  }

  .toast {
    position: absolute;
    left: 50%;
    bottom: 64px;
    transform: translateX(-50%);
    padding: 7px 12px;
    border-radius: 8px;
    font-size: 13px;
    background: var(--text);
    color: var(--bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease;
  }

  .toast[data-show] {
    opacity: 1;
  }

  .drop {
    position: absolute;
    inset: 12px;
    display: grid;
    place-items: center;
    border: 2px dashed color-mix(in srgb, var(--text) 30%, transparent);
    border-radius: 16px;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease;
  }

  .stage[data-dragover] .drop {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .stage {
      left: 0;
    }
    .crumbs {
      left: 60px;
      max-width: calc(100% - 76px);
    }
    .toolbar span:not(.divider) {
      display: none;
    }
  }
</style>


<script>
  import { Viewport, type ViewState } from '../scripts/viewport';

  const stage = document.getElementById('stage')!;
  const world = document.getElementById('world')!;
  const level = document.getElementById('zoom-level')!;
  const key = `view:${stage.dataset.folderId}`;

  const vp = new Viewport(stage, world);

  // Initial view: where you left this folder (this tab), else fit the content.
  const saved = sessionStorage.getItem(key);
  if (saved) {
    vp.set(JSON.parse(saved) as ViewState);
  } else if (stage.dataset.bounds) {
    vp.fit(JSON.parse(stage.dataset.bounds));
  }
  vp.flush();

  let saveTimer = 0;
  vp.onChange((s) => {
    level.textContent = `${Math.round(s.scale * 100)}%`;
    // Lets selection outlines and handles keep a constant on-screen size.
    world.style.setProperty('--inv', String(1 / s.scale));
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => sessionStorage.setItem(key, JSON.stringify(s)), 200);
  });

  document.getElementById('zoom-in')!.addEventListener('click', () => vp.zoomBy(1.25));
  document.getElementById('zoom-out')!.addEventListener('click', () => vp.zoomBy(0.8));
  level.addEventListener('click', () => vp.reset());

  const editing = stage.hasAttribute('data-edit');

  // Links inside items (folder cards) never navigate on a plain click; taps are
  // handled below. Keyboard Enter and modified clicks (new tab) still work.
  stage.addEventListener('click', (e) => {
    const card = (e.target as Element).closest('[data-folder-href]');
    if (!card) return;
    const keyboard = e.detail === 0;
    if (!keyboard && !e.metaKey && !e.ctrlKey && !e.shiftKey && e.button === 0) e.preventDefault();
  });

  // Tap / double-tap on items. Pointer capture retargets events, so the item
  // under the pointer is looked up here; this also gives double-tap on iOS.
  //   view mode:  tap link/file → open, tap embed → activate, double-tap folder → enter
  //   edit mode:  tap selects (editor); double-tap: folder → enter, link/file → open,
  //               embed → activate, note → edit text
  let active: HTMLElement | null = null;
  const deactivate = () => {
    if (!active) return;
    delete active.dataset.active;
    active.removeAttribute('data-interactive');
    active = null;
  };
  const activate = (el: HTMLElement) => {
    deactivate();
    active = el;
    el.dataset.active = '';
    el.setAttribute('data-interactive', ''); // viewport: don't pan from here
  };
  const open = (el: HTMLElement) => {
    const url = el.dataset.href;
    if (url) window.open(url, '_blank', 'noopener');
  };

  function onTap(el: HTMLElement, double: boolean) {
    const type = el.dataset.type;
    if (type === 'folder') {
      const href = el.querySelector<HTMLElement>('[data-folder-href]')?.dataset.folderHref;
      if (double && href) window.location.href = href;
    } else if (type === 'embed') {
      if (!editing || double) activate(el);
    } else if (type === 'link' || type === 'file') {
      if (editing ? double : !double) open(el);
    } else if (type === 'note' && editing && double) {
      stage.dispatchEvent(new CustomEvent('note-edit', { detail: el }));
    }
  }

  let last: { el: HTMLElement; t: number; x: number; y: number } | null = null;
  let down: { x: number; y: number } | null = null;
  stage.addEventListener('pointerdown', (e) => {
    down = { x: e.clientX, y: e.clientY };
    if (active && !active.contains(e.target as Node)) deactivate();
  });
  stage.addEventListener('pointerup', (e) => {
    const moved = down ? Math.hypot(e.clientX - down.x, e.clientY - down.y) : 0;
    down = null;
    if (moved > 6 || e.button !== 0) return (last = null);
    const hit = document.elementFromPoint(e.clientX, e.clientY);
    if (hit?.closest('[data-ui], .handle')) return;
    const el = hit?.closest<HTMLElement>('.item[data-item]');
    if (!el) return (last = null);
    const now = performance.now();
    const double = !!last && last.el === el && now - last.t < 350 && Math.hypot(e.clientX - last.x, e.clientY - last.y) < 24;
    last = double ? null : { el, t: now, x: e.clientX, y: e.clientY };
    onTap(el, double);
  });
  window.addEventListener('keydown', (e) => e.key === 'Escape' && deactivate());

  // Load embeds when they first come into view on the canvas. Also picks up
  // embeds the editor inserts later.
  const io = new IntersectionObserver(
    (entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        const f = en.target as HTMLIFrameElement;
        if (f.dataset.src) f.src = f.dataset.src;
        delete f.dataset.src;
        io.unobserve(f);
      }
    },
    { root: stage, rootMargin: '400px' },
  );
  const watch = (root: Element) => root.querySelectorAll('iframe[data-src]').forEach((f) => io.observe(f));
  watch(world);
  new MutationObserver((ms) => ms.forEach((m) => m.addedNodes.forEach((n) => n instanceof Element && watch(n)))).observe(world, { childList: true });

  if (editing) {
    import('../scripts/editor').then(({ initEditor }) => initEditor(vp, stage, world));
  }
</script>
