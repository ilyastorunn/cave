---
import type { FolderNode, FolderTree } from '../lib/db';
import TreeNode from './TreeNode.astro';
import { href } from '../lib/page';

interface Props {
  tree: FolderTree;
  /** Folder whose canvas is shown; null on the 404 page. */
  current: FolderNode | null;
  chain: FolderNode[];
  base: string;
  edit: boolean;
}

const { tree, current, chain, base, edit } = Astro.props;
const home = href(base, '/');
const activeId = current?.id ?? '';
// Ancestors of the current folder (and the folder itself) start expanded.
const openIds = new Set(chain.map((f) => f.id));
const isRoot = activeId === tree.root.id;
---

<aside class="sidebar" id="sidebar" data-open="false">
  <header class="brand">
    <a href={home} class="logo">ily-cave{edit && <span class="badge">düzenleme</span>}</a>
    <button class="close" id="sidebar-close" aria-label="Paneli kapat">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
  </header>

  <nav class="tree" aria-label="Klasörler">
    <a href={home} class:list={['home', { active: isRoot }]} aria-current={isRoot ? 'page' : undefined}>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="3" stroke="currentColor" stroke-width="1.4"/></svg>
      <span>{tree.root.name}</span>
    </a>

    {
      tree.root.children.length ? (
        <div class="folders">
          {tree.root.children.map((node) => (
            <TreeNode node={node} activeId={activeId} openIds={openIds} depth={0} base={base} />
          ))}
        </div>
      ) : (
        <p class="empty">Henüz klasör yok</p>
      )
    }
  </nav>
</aside>

<button class="sidebar-toggle" id="sidebar-toggle" aria-label="Paneli aç" aria-controls="sidebar">
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
</button>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--sidebar-w);
    background: var(--panel);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    z-index: 20;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .brand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 16px 14px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .badge {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 2px 7px;
    border-radius: 99px;
    color: var(--muted);
    background: var(--hover);
  }

  .close {
    display: none;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    place-items: center;
    color: var(--muted);
  }

  .tree {
    flex: 1;
    overflow-y: auto;
    padding: 4px 8px 16px;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .home {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 6px;
    color: var(--muted);
  }

  .home:hover {
    background: var(--hover);
    color: var(--text);
  }

  .home.active {
    background: var(--active);
    color: var(--text);
  }

  .folders {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .empty {
    margin: 8px 8px 0;
    font-size: 12px;
    color: var(--muted);
  }

  .sidebar-toggle {
    display: none;
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 15;
    width: 36px;
    height: 36px;
    border-radius: var(--radius);
    background: var(--panel);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    place-items: center;
  }

  @media (max-width: 767px) {
    .sidebar {
      transform: translateX(-100%);
      box-shadow: var(--shadow);
    }
    .sidebar[data-open='true'] {
      transform: none;
    }
    .close,
    .sidebar-toggle {
      display: grid;
    }
  }
</style>

<script>
  const sidebar = document.getElementById('sidebar')!;
  const setOpen = (open: boolean) => (sidebar.dataset.open = String(open));
  document.getElementById('sidebar-toggle')!.addEventListener('click', () => setOpen(true));
  document.getElementById('sidebar-close')!.addEventListener('click', () => setOpen(false));

  // Clicking a folder name navigates; only the chevron toggles the branch.
  for (const link of sidebar.querySelectorAll<HTMLAnchorElement>('summary a')) {
    link.addEventListener('click', (e) => e.stopPropagation());
  }
  for (const summary of sidebar.querySelectorAll<HTMLElement>('summary')) {
    summary.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.chev')) e.preventDefault();
    });
  }
</script>
