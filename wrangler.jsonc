{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ily-cave",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ily-cave",
      // No database_id yet: wrangler provisions the database on first deploy.
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // Uploaded images, GIFs and files. Served publicly through /files/<key>.
    { "binding": "FILES", "bucket_name": "ily-cave-files" }
  ],
  "vars": {
    // Cloudflare Access (phase 5). Until both are set, /admin and /api/admin
    // are refused in production. In `npm run dev` they are open.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
